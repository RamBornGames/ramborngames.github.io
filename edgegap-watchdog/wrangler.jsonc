{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compersion-edgegap-watchdog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "routes": [
    {
      "pattern": "compersion.charliefeuerborn.com/watchdog/*",
      "zone_name": "charliefeuerborn.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCHDOG",
        "class_name": "Watchdog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Watchdog"]
    }
  ],
  "vars": {
    "HEALTH_URL": "wss://compersion.charliefeuerborn.com",
    "PUBLIC_ORIGIN": "https://ramborngames.github.io",
    "ENABLE_DEPLOYMENTS": "true",
    "CONFIG_GENERATION": "2026-09-04-immediate-west-coast",
    "INITIAL_DEPLOYMENT_ID": "",
    "EDGEGAP_APPLICATION": "compersion",
    "EDGEGAP_VERSION": "26.08.11-watchdog-secure",
    "EDGEGAP_DEPLOYMENT_USERS_JSON": "[{\"user_type\":\"geo_coordinates\",\"user_data\":{\"latitude\":34.0522,\"longitude\":-118.2437}}]",
    "FAILURES_BEFORE_DEPLOY": "1",
    "MIN_CHECK_INTERVAL_SECONDS": "5",
    "DEPLOY_COOLDOWN_SECONDS": "900",
    "REPLACEMENT_TIMEOUT_SECONDS": "600",
    "STOP_TIMEOUT_SECONDS": "300",
    "MAX_DEPLOYMENTS_PER_HOUR": "3",
    "MAX_DEPLOYMENTS_PER_DAY": "6"
  },
  "observability": {
    "enabled": true
  }
}
